{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VeleroBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::HUB_BACKUP_BUCKET"
    },
    {
      "Sid": "VeleroObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::HUB_BACKUP_BUCKET/acm-hub/*"
    },
    {
      "Sid": "EncryptWithKms",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "HUB_KMS_KEY_ARN"
    }
  ]
}
