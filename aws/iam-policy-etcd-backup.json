{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListForUploadVerification",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::SNAPSHOT_BUCKET",
        "arn:aws:s3:::KEYS_BUCKET"
      ]
    },
    {
      "Sid": "WriteSnapshots",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::SNAPSHOT_BUCKET/*",
        "arn:aws:s3:::KEYS_BUCKET/*"
      ]
    },
    {
      "Sid": "DenyDestructiveActions",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": [
        "arn:aws:s3:::SNAPSHOT_BUCKET/*",
        "arn:aws:s3:::KEYS_BUCKET/*"
      ]
    },
    {
      "Sid": "EncryptWithKms",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Encrypt",
        "kms:DescribeKey"
      ],
      "Resource": [
        "SNAPSHOT_KMS_KEY_ARN",
        "KEYS_KMS_KEY_ARN"
      ]
    }
  ]
}
